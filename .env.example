# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External SEO Data Provider APIs (for genuine third-party SERP & search volume)
# When not provided, RankPilot displays transparent AI estimates and clearly labeled demo indicators.
SEO_DATA_API_KEY=""
SERP_API_KEY=""
YOUTUBE_API_KEY=""
